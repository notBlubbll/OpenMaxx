{
  "$schema": "https://opencode.ai/config.json",
  "model": "openference/GLM-5.2",
  "small_model": "openference/GLM-5.2",
  "subagent_depth": 3,
  "instructions": [
    "~/.config/opencode/instructions/AGENTS.md",
    "AGENTS.md"
  ],
  "compaction": {
    "prune": false
  },
  "mcp": {
    "mind": {
      "type": "local",
      "command": [
        "C:\\Users\\User\\Documents\\mind\\mind",
        "mcp"
      ],
      "enabled": false
    }
  },
  "agent": {
    "build": {
      "model": "openference/GLM-5.2",
      "permission": {
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "bash": "deny",
        "task": { "general": "allow", "research": "allow" }
      }
    },
    "explore": {
      "model": "agnes/agnes-2.5-flash",
      "permission": { "edit": "deny", "bash": "deny", "task": { "summarizer": "allow" } }
    },
    "summarizer": {
      "model": "agnes/agnes-2.5-flash",
      "permission": { "edit": "allow", "bash": "allow", "task": {} }
    },
    "research": {
      "model": "agnes/agnes-2.5-flash",
      "permission": { "edit": "deny", "bash": "allow", "task": { "summarizer": "allow" } }
    },
    "edit": {
      "model": "agnes/agnes-2.5-flash",
      "permission": { "edit": "allow", "bash": "allow", "task": { "explore": "allow" } }
    },
    "general": {
      "model": "openference/DeepSeek-V4-Pro-0813",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": { "research": "allow", "edit": "allow" }
      }
    }
  },
  "provider": {
    "openference": {
      "name": "OpenFerence",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.openference.com/v1",
        "apiKey": "{env:OPENFERENCE_API_KEY}"
      },
      "models": {
        "GLM-5.2": {
          "name": "GLM-5.2",
          "reasoning": true,
          "variants": {
            "max": { "thinking": { "type": "enabled", "budget_tokens": 65536 } }
          },
          "limit": { "context": 262144, "input": 262144, "output": 73728 }
        },
        "DeepSeek-V4-Pro-0813": {
          "name": "DeepSeekV4Pro",
          "reasoning": true,
          "tool_call": true,
          "variants": {
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          },
          "limit": { "context": 664576, "output": 384000 }
        }
      }
    },
    "agnes": {
      "name": "Agnes AI",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://apihub.agnes-ai.com/v1",
        "apiKey": "{env:AGNES_API_KEY}"
      },
      "models": {
        "agnes-2.5-flash": {
          "name": "Agnes 2.5 Flash",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "explore": { "thinking": { "type": "enabled", "budget_tokens": 2048 } },
            "research": { "thinking": { "type": "enabled", "budget_tokens": 4096 } },
            "edit": { "thinking": { "type": "enabled", "budget_tokens": 8192 } }
          },
          "limit": { "context": 512000, "output": 65536 }
        }
      }
    }
  }
}
