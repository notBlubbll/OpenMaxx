{
  "$schema": "https://opencode.ai/config.json",
  "model": "openference-anthropic/GLM-5.2",
  "small_model": "opencode/Ox Alpha",
  "subagent_depth": 3,
  "instructions": [
    "~/.config/opencode/instructions/AGENTS.md",
    "AGENTS.md"
  ],
  "compaction": {
    "prune": false
  },
  "mcp": {
    "mind": {
      "type": "local",
      "command": [
        "C:\\Users\\User\\Documents\\mind\\mind",
        "mcp"
      ],
      "enabled": false
    }
  },
  "agent": {
    "build": {
      "model": "opencode/Ox Alpha",
      "color": "primary",
      "permission": {
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "bash": "deny",
        "task": { "coordinator": "allow", "research": "allow", "detective": "allow" }
      }
    },
    "summarizer": {
      "model": "agnes/agnes-2.5-flash",
      "steps": 3,
      "color": "#c0c0c0",
      "permission": { "edit": "allow", "bash": "deny", "task": {} }
    },
    "research": {
      "model": "agnes/agnes-2.5-flash",
      "color": "#7aa2f7",
      "permission": { "edit": "deny", "bash": "allow", "task": { "summarizer": "allow" } }
    },
    "detective": {
      "model": "openference-anthropic/GLM-5.2",
      "color": "#8b5a2b",
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "task": { "research": "allow", "summarizer": "allow" }
      }
    },
    "edit": {
      "model": "agnes/agnes-2.5-flash",
      "color": "#ffd54f",
      "permission": { "edit": "allow", "bash": "allow", "task": {} }
    },
    "coordinator": {
      "model": "openference-anthropic/DeepSeek-V4-Pro-0813",
      "color": "#555555",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "glob": "deny",
        "grep": "deny",
        "task": { "research": "allow", "edit": "allow" }
      }
    }
  },
  "provider": {
    "openference": {
      "name": "OpenFerence",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.openference.com/v1",
        "apiKey": "{env:OPENFERENCE_API_KEY}"
      },
      "models": {

        "Ox Alpha": {
          "name": "Ox Alpha",
          "tool_call": true,
          "limit": { "context": 1050000, "output": 131072 }
        }
      }
    },
    "openference-anthropic": {
      "name": "OpenFerence (Anthropic)",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://api.openference.com/v1",
        "apiKey": "{env:OPENFERENCE_API_KEY}",
        "timeout": 600000,
        "chunkTimeout": 30000,
        "headers": {
          "Authorization": "Bearer {env:OPENFERENCE_API_KEY}",
          "anthropic-version": "2023-06-01"
        }
      },
      "models": {
        "DeepSeek-V4-Pro-0813": {
          "name": "DeepSeek V4 Pro 0813",
          "reasoning": true,
          "tool_call": true,
          "variants": {
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          },
          "limit": { "context": 664576, "output": 384000 }
        },
        "GLM-5.2": {
          "name": "GLM 5.2",
          "reasoning": true,
          "variants": {
            "max": { "thinking": { "type": "enabled", "budget_tokens": 65536 } }
          },
          "tool_call": true,
          "limit": { "context": 262144, "output": 128000 }
        }
      }
    },
    "agnes": {
      "name": "Agnes AI",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://apihub.agnes-ai.com/v1",
        "apiKey": "{env:AGNES_API_KEY}",
        "timeout": 600000,
        "chunkTimeout": 30000
      },
      "models": {
        "agnes-2.5-flash": {
          "name": "Agnes 2.5 Flash",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "variants": {
            "explore": { "thinking": { "type": "enabled", "budget_tokens": 2048 } },
            "research": { "thinking": { "type": "enabled", "budget_tokens": 4096 } },
            "edit": { "thinking": { "type": "enabled", "budget_tokens": 8192 } }
          },
          "limit": { "context": 512000, "output": 65536 }
        }
      }
    }
  }
}
