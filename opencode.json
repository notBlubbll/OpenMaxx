{
  "$schema": "https://opencode.ai/config.json",
  "model": "hypercharm/glm-5.3-flash",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "shell": "cmd",
  "experimental": {
    "subagent_depth": 4
  },
  "instructions": [
    "AGENTS.md"
  ],
  "agents": {
    "explore": {
      "mode": "subagent",
      "model": "agnes-research/agnes-2.5-flash#explore",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "write_findings",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "research": {
      "mode": "subagent",
      "model": "airouter/DeepSeek-V4-Flash#research",
      "steps": 30,
      "color": "#7aa2f7",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "write_findings",
          "resource": "*",
          "effect": "allow"
        }
      ],
      "settings": {
        "reasoningEffort": "high"
      }
    },
    "research-worker": {
      "mode": "subagent",
      "model": "airouter/DeepSeek-V4-Flash#research-worker",
      "steps": 20,
      "color": "#7aa2f7",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "write_findings",
          "resource": "*",
          "effect": "allow"
        }
      ],
      "settings": {
        "reasoningEffort": "low"
      }
    },
    "detective": {
      "mode": "subagent",
      "model": "hypercharm/glm-5.3-flash",
      "steps": 40,
      "color": "#8b5a2b",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "research-worker",
          "effect": "allow"
        },
        {
          "action": "write_findings",
          "resource": "*",
          "effect": "allow"
        }
      ],
      "settings": {
        "reasoningEffort": "high"
      }
    },
    "edit": {
      "mode": "subagent",
      "model": "airouter/Qwen3.8#edit",
      "steps": 40,
      "color": "#ffd54f",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        }
      ],
      "settings": {
        "reasoningEffort": "medium"
      }
    },
    "coordinator": {
      "description": "🤖Coordinator sub-orchestrator for complex multi-step work. Plans, sequences, and delegates implementation to edit subagents. Cannot edit, run shell, or use edit tools itself.",
      "mode": "subagent",
      "model": "hypercharm/qwen3-next-80b-a3b-instruct",
      "steps": 40,
      "color": "#555555",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "write_findings",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "research",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "edit",
          "effect": "allow"
        }
      ],
      "settings": {
        "reasoningEffort": "low"
      }
    }
  },
  "providers": {
    "ifm": {
      "name": "IFM",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8089/v1",
        "apiKey": "REPLACE_WITH_REAL_KEY",
        "timeout": 1800000
      },
      "models": {
        "IFM/K2-Horizon-375B-A23B": {
          "name": "K2 Horizon 375B A23B",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "variants": [
            { "id": "research", "settings": { "reasoningEffort": "high" } },
            { "id": "edit", "settings": { "reasoningEffort": "high" } }
          ],
          "limit": { "context": 524288, "output": 32768 }
        }
      }
    },
    "agnes-research": {
      "name": "Agnes AI (research)",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://apihub.agnes-ai.com/v1",
        "apiKey": "REPLACE_WITH_REAL_KEY",
        "timeout": 1800000
      },
      "models": {
        "agnes-2.5-flash": {
          "name": "Agnes 2.5 Flash (research)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": [
            { "id": "explore", "settings": { "thinking": { "type": "enabled", "budget_tokens": 2048 } } },
            { "id": "research", "settings": { "thinking": { "type": "enabled", "budget_tokens": 16384 } } }
          ],
          "limit": { "context": 512000, "output": 65536 }
        }
      }
    },
    "agnes-execute": {
      "name": "Agnes AI (execute)",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://apihub.agnes-ai.com/v1",
        "apiKey": "REPLACE_WITH_REAL_KEY",
        "timeout": 1800000
      },
      "models": {
        "agnes-2.5-flash": {
          "name": "Agnes 2.5 Flash (execute)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": [
            { "id": "edit", "settings": { "thinking": { "type": "enabled", "budget_tokens": 16384 } } }
          ],
          "limit": { "context": 512000, "output": 65536 }
        }
      }
    },
    "camelai": {
      "name": "camelStream",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://stream.camelai.com/v1",
        "apiKey": "REPLACE_WITH_REAL_KEY",
        "timeout": 1800000
      },
      "models": {
        "auto": {
          "name": "Camel Auto (fleet)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "max", "settings": { "thinking": { "type": "enabled", "budget_tokens": 4096 } } }
          ],
          "limit": { "context": 262144, "output": 65536 }
        }
      }
    },
    "airouter": {
      "name": "AI Router",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.airouter.ch/v1",
        "apiKey": "REPLACE_WITH_REAL_KEY",
        "timeout": 1800000
      },
      "models": {
        "Qwen3.8": {
          "name": "Qwen-3.8-27B",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "research", "settings": { "reasoningEffort": "high" } },
            { "id": "edit", "settings": { "reasoningEffort": "high" } }
          ],
          "limit": { "context": 262144, "output": 65536 }
        },
        "DeepSeek-V4-Flash": {
          "name": "DeepSeek-V4-Flash-0731",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "research", "settings": { "reasoningEffort": "high" } },
            { "id": "research-worker", "settings": { "reasoningEffort": "low" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ],
          "limit": { "context": 920576, "output": 32768 }
        }
      }
    },
    "hypercharm": {
      "name": "HyperCharm",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://hyper.charm.land/v1",
        "apiKey": "REPLACE_WITH_REAL_KEY",
        "timeout": 1800000
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ],
          "limit": { "context": 1048576, "output": 131072 }
        },
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ],
          "limit": { "context": 1000000, "output": 384000 }
        },
        "deepseek-v4-pro-0813": {
          "name": "DeepSeek V4 Pro 0813",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ],
          "limit": { "context": 1048576, "output": 262144 }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ],
          "limit": { "context": 1000000, "output": 384000 }
        },
        "glm-5.3": {
          "name": "GLM 5.3",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ],
          "limit": { "context": 1048576, "output": 262144 }
        },
        "qwen3.8-flash": {
          "name": "Qwen3.8 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ],
          "limit": { "context": 1000000, "output": 128000 }
        },
        "qwen3-next-80b-a3b-instruct": {
          "name": "Qwen3 Next 80B-A3B Instruct",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ],
          "limit": { "context": 1048576, "output": 131072 }
        },
        "gpt-oss-120b": {
          "name": "GPT-OSS-120B",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } }
          ],
          "limit": { "context": 128072, "output": 13107 }
        }
      }
    }
  },
  "plugins": [
    "file:///HINTFORLLM:REPLACEWITHREALOPENCODEPATH/opencode/plugins/edit-tool-fix.js",
    "file:///HINTFORLLM:REPLACEWITHREALOPENCODEPATH/opencode/plugins/write-findings.js",
    "file:///HINTFORLLM:REPLACEWITHREALOPENCODEPATH/opencode/plugins/grep-fix.js",
    "file:///HINTFORLLM:REPLACEWITHREALOPENCODEPATH/opencode/plugins/mind-automation.js"
  ]
}
